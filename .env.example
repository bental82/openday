# Google Sheets access — pick ONE of the two options:

# Option 1: the full service-account JSON key as a single line
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 2: path to the service-account key file
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# The spreadsheet to process (defaults to the Meetings4 sheet if omitted)
# SPREADSHEET_ID=1Vv0wwcWg9buz6myZHvH3BRORszKVPvtvA-_iHn-SVB0

# Worksheet names (defaults shown)
# MAIN_WORKSHEET_NAME=Sheet1
# LIST_WORKSHEET_NAME=list
# NEW_WORKSHEET_NAME=new

# API server port
# PORT=3001
